APP_ENV=development
DATABASE_URL=sqlite:///./ingredient_intelligence.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
PRODUCT_DISCOVERY_EXTERNAL_ENABLED=true
PRODUCT_DISCOVERY_TIMEOUT_SECONDS=4
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
CATALOG_TRANSLATION_ENABLED=true
CATALOG_TRANSLATION_BASE_URL=https://api.mymemory.translated.net/get
CATALOG_TRANSLATION_TIMEOUT_SECONDS=3
CATALOG_TRANSLATION_CONCURRENCY=4
RATE_LIMIT_REQUESTS_PER_MINUTE=120
